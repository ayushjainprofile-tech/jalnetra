# Server Port (Hostinger/Render will automatically assign if omitted)
PORT=3001

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# IoT Ingestion Security Key (for ESP32 sensor POST requests)
DEVICE_API_KEY=dev-device-key

# Allowed CORS origins (* allows all)
CORS_ORIGIN=*

# Optional Supabase Database Configuration (leave blank for local in-memory store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

